
<%- include('partials/header') %>
<%- include('partials/refresh-script') %>

<main class="container py-5 text-center">

	<div>
		<h1>Register</h1>
	</div>

    
	    <div class="mb-3">
	        <input autocomplete="off" autofocus class="form-control mx-auto w-auto" placeholder="Username" type="text" id="username">
	    </div>
	    <div class="mb-3">
	        <input class="form-control mx-auto w-auto" placeholder="Password" type="password" id="password">
	    </div>
	    <div class="mb-3">
	        <input class="form-control mx-auto w-auto" placeholder="Confirm" type="password" id="confirmation">
	    </div>
	    <button class="btn btn-primary" id="submit">Register</button>
	
	<p id="errors"></p>
</main>

<script>

	// Prevent inputs from submitting forms and auto focus on the next input
	const inputs = document.querySelectorAll("input");

	for (let i = 0; i < inputs.length - 1; i ++) {
		inputs[i].addEventListener("keydown", event => {
			if (event.keyCode === 13) {
				inputs[i + 1].focus();
			}
		})
	}

	inputs[inputs.length - 1].addEventListener("keydown", event => {
		if (event.keyCode === 13) register();
	});

	document.querySelector("#submit").addEventListener("click", register);

	async function register () {
		
		const username = document.querySelector("#username").value;
		const password = document.querySelector("#password").value;
		const confirmation = document.querySelector("#confirmation").value;

		const response = await fetch('/register', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ username, password, confirmation })
		});

		const data = await response.json();

		if (response.ok) {
			localStorage.setItem("refreshToken", data.refreshToken)
			window.location.replace("./");
		} else {
			document.querySelector("#errors").innerHTML = data.error;
		}
	}

</script>

<%- include('partials/footer') %>