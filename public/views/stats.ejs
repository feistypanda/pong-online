
<%- include('partials/header-top') %>
<style>
	#title-container {
		padding-bottom: 2rem;
	}

	#title {
		font-size: 5rem;
		font-weight: 800;
	}

	#leaderboard {
		width: 70%;
		padding: 1rem;
		margin: auto;
		--bs-table-bg: var(--black);
		--bs-table-color: var(--white);
		font-size: 1.5rem;
	}

</style>
<%- include('partials/header-bottom') %>

<main class="container py-5 text-center">
	<div id="title-container">
		<h1 id="title">Leaderboard</h1>
	</div>

	<table class="table" id="leaderboard">
		<thead id="table-change">
			<tr>
				<th scope="col">#</th>
				<th scope="col">Username</th>
				<th scope="col">Elo</th>
			</tr>
		</thead>
		<tbody class="table-change">
			<% for (let i = 0; i < places.length; i ++) { %>
				<% if (!isNaN(places[i].elo)) { %>
					<tr>
						<th scope="row"><%= i + 1 %></th>
						<td><%= places[i].username %></td>
						<td><%= Math.round(places[i].elo) %></td>
					</tr>
				<% } %>
			<% } %>
		</tbody>
	</table>

</main>

<%- include('partials/footer') %>