
<%- include('partials/header') %>

<main class="container py-5 text-center">

	<div>
		<h1>Log In</h1>
	</div>

    <div class="mb-3">
        <input autocomplete="off" autofocus class="form-control mx-auto w-auto" id="username" placeholder="Username" type="text">
    </div>
    <div class="mb-3">
        <input class="form-control mx-auto w-auto" id="password" placeholder="Password" type="password">
    </div>
    <button class="btn btn-primary" id="submit">Log In</button>

	<p id="errors"></p>
</main>

<script>

	// Prevent inputs from submitting forms and auto focus on the next input
	const inputs = document.querySelectorAll("input");

	for (let i = 0; i < inputs.length - 1; i ++) {
		inputs[i].addEventListener("keydown", event => {
			if (event.keyCode === 13) inputs[i + 1].focus();
		})
	}

	inputs[inputs.length - 1].addEventListener("keydown", event => {
		if (event.keyCode === 13) login();
	});

	document.querySelector("#submit").addEventListener("click", login);

	async function login () {
		
		const username = document.querySelector("#username").value;
		const password = document.querySelector("#password").value;

		const response = await fetch('/login', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ username, password })
		});

		const data = await response.json();

		if (response.ok) window.location.replace("./");
		else document.querySelector("#errors").innerHTML = data.error;
	}
</script>

<%- include('partials/footer') %>