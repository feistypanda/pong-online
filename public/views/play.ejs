<main class="text-center" style="padding-top: 3rem">
</main>

<script src="https://cdn.jsdelivr.net/gh/NS236/p5.js-ka@main/lib/p5.js"></script>
<script> new p5();</script>

<script>

function redirect (url) {
	window.location.replace(url);
}

const [WIDTH, HEIGHT] = [1000, 600];

let delataTime = 33;
let click = false;
let keys = {};

let gameState = 'waiting';
let redirected = false;

const scenes = (() => {

	const startScene = "waiting";

	// returns an object with a function for each scene and a function that runs the current scene. This function will also transition to a new scene at the end of the frame if necesary.
	// the reason that the scene functions are the way they are(an iife returning a function) is so that each scene can have a local scope to store data that is only relevant to the scene.

	return {
		current: startScene,

		run () {
			this[this.current](); // run the current scene

			click = false;

			if (scenes.nextTransition) { // transition
				scenes.nextTransition[1] = scenes.nextTransition[1](); // get the image of the canvas at the time of the start of the transition
				scenes.transition(...scenes.nextTransition)
			};
		},

		nextTransition: false,
		transitionTo: false, // so buttons can display during the transition
	
		transition: (() => {
		
			const anim1 = x => 4 *(x - 0.5) ** 3 + 0.5;

			let fromImg;
			let to = "";
			let amt = 0;
			let speed = 1;
			let data = false;
			let sentData = false;
			let transitionType = "slide";
			let transitionData = false;
	
			return function (_to, img, _speed, _transitionType = "slide", _data, _transitionData) {
	
				amt += (delataTime)/1000/speed;
				
				if (_to) {

					// so we dont try to transition twice
					scenes.nextTransition = false;
					
					// reset data for the transition
					to = _to;
					scenes.transitionTo = to;
					transitionType = _transitionType;
					fromImg = img;
					scenes.current = "transition";
					amt = 0;
					data = _data || false;
					transitionData = _transitionData || false;
					sentData = false;

					if (_speed && _speed > 0) speed = _speed;
				}
	
				if (amt < 0.5) {
					// display image from last scene
					image(fromImg, 0, 0, width, height);
				} else if (amt < 1){
					// run the next scene
					if (sentData) {
						scenes[to]();
					} else {
						scenes[to](data);
						sentData = true;
					}
					
				} else {
					// switch to the next scene
					scenes.current = to;
					scenes.transitionTo = false;
				}

				// the gray square that sweeps over the screen
				fill(28, 28, 28);
				noStroke();
				rect(-width + width * anim1(amt) * 2, 0, width, height);
				
			}
		})(),
		
		waiting: (() => {

			const getMsg = (() => {
				let frames = 0;

				return function () {

					frames ++;

					let cycleLen = 120;
					let cycle = frames % cycleLen;

					let num = Math.min(Math.floor((cycle < cycleLen/2 ? cycle : (cycleLen - cycle))/12), 4);

					let dots = '';

					for (let i = 0; i < num; i ++) dots += '.';

					return 'waiting for players' + dots;
				}
			})();
			

			return function () {
				background(50);
				
				fill(200);
				noStroke();

				textAlign(CENTER, CENTER);
				textSize(70);
				textFont('Arial Black');
				text(getMsg(), width/2, 250);

				if (gameState.status === "game") return scenes.nextTransition = ["play", get, 1];
				if (gameState.status === "over") return scenes.nextTransition = ["gameOver", get, 1];
			}
		})(),

		play: (() => {

			function displayPlayers (flip) {
				for (let i = 0; i < gameState.playerPositions.length; i ++) {
					const p = gameState.playerPositions[i];
					const w = gameState.playerW[i];
					const h = gameState.playerH[i];

					let x = p.x;
					if (flip) x = width - x;

					rect (x - w/2, p.y - h/2, w, h);
				}
			}

			function displayBall (flip) {
				if (gameState.countDown) return;

				let bP = gameState.ballPosition;
				let bS = gameState.ballSize;
				let x = bP.x;
				if (flip) x = width - x;

				rect(x - bS/2, bP.y - bS/2, bS, bS);
			}

			function displayNames (flip) {
				textSize(40);
				stroke(200);
				strokeWeight(2);

				textAlign(LEFT, TOP);
				text(gameState.usernames[flip], 40, 40);

				textAlign(RIGHT, TOP);
				text(gameState.usernames[+(!flip)], width - 40, 40);

				textAlign(CENTER, TOP);
				text(`${gameState.score[flip]} - ${gameState.score[+(!flip)]}`, width/2, 40);
			}

			function displayCountDown () {

				const time = gameState.countDown;
				
				if (!time) return;
				if (time < 3000 && time % 1000 < 300) return;
				
				textAlign(CENTER, CENTER);
				textSize(70);
				strokeWeight(3);
				text(Math.min(3, Math.ceil(gameState.countDown/1000)), width/2, height/2);
			}

			return function () {
				background(50);
				noStroke();
				fill(200);

				if (gameState.status === "waiting") return scenes.nextTransition = ["waiting", get, 1];
				if (gameState.status === "over") return scenes.nextTransition = ["gameOver", get, 1];

				const flip = gameState.iAm;

				displayPlayers(flip);
				displayBall(flip);
				displayNames(flip);
				displayCountDown();
			}
		})(),

		gameOver: (() => {
			return function () {

				if (redirected) return;

				background(50);
				
				const dat = gameState;

				const url = new URL(`http://${window.location.host}/results`);
				const params = url.searchParams;

				params.append('players', dat.usernames);
				params.append('self', dat.iAm);
				params.append('winner', dat.winner);
				params.append('reason', dat.reason);
				if (dat.reason === 'win') params.append('score', dat.score);
				if (dat.eloChange) params.append('elo', Math.round(dat.eloChange[dat.iAm]));

				console.log("attempting redirect");
				redirect(url.toString());
				redirected = true;
				console.log("attempted redirect");
			}
		})(),
	};
})();
	
const drawFunction = (() => {

	// for delta time calculations
	let then = performance.now();

	// not using function x() {} notation because iife. iife is simply for organization here
	setup = function() {
	
		// this clears all animation frames preventing them from stacking up if the webpage is reloaded
		// sourced from stack overflow somewhere
		let id = window.requestAnimationFrame(function(){});
		while (id--) {
			window.cancelAnimationFrame(id);
		}
		
		createCanvas(WIDTH, HEIGHT);
		frameRate(60);
	};
	
	draw = function() {

		let now = performance.now();
		delataTime = now - then;
		then = now;

		scenes.run();
	};
})();

const userInput = (() => {
    // not using function x() {} notation because iife. iife is simply for organization here

    mousePressed = function() {
        click = true;
    }

    function sendDirection () {
    	if (keys.w && keys.s || !keys.w && !keys.s) sendMessage ('');
    	else if (keys.w) sendMessage ('up');
    	else if (keys.s) sendMessage ('down');
    }

    keyPressed = function() {
        keys[key] = keys[key.toString().toLowerCase()] = true;
        sendDirection();
    }
    
    keyReleased = function() {
        keys[key] = keys[key.toString().toLowerCase()] = false;
		sendDirection();
    }
})();


let sendMessage = x => x;
let connected = false;

function connectToServer () {

	if (connected) return false;

	const accessToken = localStorage.getItem("accessToken");
	const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
	const ws = new WebSocket(`${protocol}//${window.location.host}`, [accessToken]);

	ws.onopen = () => {
		console.log("connected");
		connected = true;
	}

	ws.onmessage = async (event) => {
		gameState = JSON.parse(event.data);
	};

	ws.onclose = (event) => {
		console.log('disconnected');
		connected = false;

		if (event.reason !== 'game over' && event.code === 1000) {
			const url = new URL(`http://${window.location.host}/results`);
			const params = url.searchParams;
			params.append('disconnect', 'true');
			params.append('message', event.reason);
			redirect(url.toString());
		}
	};

	sendMessage = function (msg) {
		ws.send(msg);
	}

	return true;
}

connectToServer();

// ping the server

let pinger = setInterval(x => {
	sendMessage('ping');
}, 200);

</script>


