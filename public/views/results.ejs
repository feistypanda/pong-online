
<%- include('partials/header-top') %>
<%- include('partials/results-styles') %>
<%- include('partials/footer-style-fixed') %>
<%- include('partials/header-bottom') %>

<div id="info-container">

	<p id="players"></p>

	<h1 id="display"></h1>

	<p id="score"></p>
	<p id="elo"></p>

	<p>
		<a id="play-again" class="btn btn-primary" href="./play">Play Again?</a>
	</p>
</div>

<script>

	function main () {
		let params = new URL(document.location.toString()).searchParams;

		if (params.get('timeout')) return document.querySelector('#display').innerHTML = 'Disconnected';

		let players = params.get('players')?.split(',');
		let winner = +params.get('winner');
		let loser = (winner + 1) % players.length;
		let self = +params.get('self');
		let opponent = (self + 1) % players.length;	
		let reason = params.get('reason');
		let score = params.get('score')?.split(',');
		let eloChange = params.get('elo');

		const playersDisplay = document.querySelector('#players');
		playersDisplay.innerHTML = `${players[self].toUpperCase()} vs ${players[opponent].toUpperCase()}`;

		const display = document.querySelector('#display');
		
		if (winner === self) display.innerHTML = 'VICTORY!';
		else display.innerHTML = 'DEFEAT!';

		const scoreDisplay = document.querySelector('#score');
		if (reason === 'win') scoreDisplay.innerHTML = `${players[winner]} wins ${score[winner]} - ${score[loser]}`;
		else if (reason === 'disconnect') scoreDisplay.innerHTML = `${players[(winner + 1) % players.length]} disconnected`;

		// update elo
		if (eloChange) fetch('./api/myelo').then(elo => {
			elo.json().then(elo => {
				document.querySelector('#elo').innerHTML = `${parseInt(eloChange) > 0 ? '+' : ''}${eloChange} elo! You now have ${Math.round(parseFloat(elo))} elo`;
			})
		})
		
	}

	main();
	
</script>

<%- include('partials/footer') %>